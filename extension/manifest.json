{
  "manifest_version": 3,
  "name": "食安毒油即時查詢與AI辨識器",
  "version": "1.0.0",
  "description": "即時比對衛福部食藥署毒油與下架食品名單，支援關鍵字、條碼與 AI 外包裝照片辨識。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "食安毒油即時查詢"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.momo.com.tw/*",
        "https://*.pchome.com.tw/*",
        "https://*.shopee.tw/*",
        "https://*.carrefour.com.tw/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"]
    }
  ]
}
